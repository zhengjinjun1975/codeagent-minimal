{
  "name": "batch-fs",
  "version": "0.1.0",
  "domain": "tools",
  "description": "通用工具原子(省重复 P1-3): 批量文件操作(列文件/哈希/去重/重命名/按扩展名整理), 包装 pycommon + E:/scripts/fs。纯 stdlib 数据不出厂。",
  "open_source": true,
  "agent_class": "BatchFsAgent",
  "entry": "main.py",
  "provides": ["fs.list", "fs.hash", "fs.dedup", "fs.rename", "fs.organize"],
  "depends_on": [],
  "inputs": ["action", "d", "p", "prefix", "suffix", "dry", "recursive"],
  "outputs": ["result", "error", "duplicates", "pairs", "changed", "moved"],
  "path": "agents/tools/batch-fs"
}
