{
  "name": "task-state",
  "version": "0.1.0",
  "domain": "taskstate",
  "description": "任务状态原子: 复用外置任务状态模块(做到哪/下一步/证据/决策点), 跨会话续跑不丢进度。taskstate.track 跟踪状态。",
  "open_source": true,
  "agent_class": "TaskStateAgent",
  "entry": "main.py",
  "provides": ["taskstate.track"],
  "depends_on": [],
  "inputs": ["task", "action", "tid", "state", "progress", "evidence", "gate", "status_file"],
  "outputs": ["status", "task_id", "file", "progress"]
}
