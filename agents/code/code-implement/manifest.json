{
  "name": "code-implement",
  "version": "0.2.0",
  "domain": "code",
  "description": "写码原子: 底层用仓库自包含 code_agent_engine(规划+自动复用+迭代循环+可选工作日志落库), 将任务实现为生产代码写入磁盘。可用于代码实现编排与真实写码。",
  "open_source": true,
  "agent_class": "CodeImplementAgent",
  "entry": "main.py",
  "provides": [
    "code.implement",
    "code.write"
  ],
  "depends_on": [],
  "inputs": [
    "task",
    "language",
    "path",
    "output_dir",
    "domain",
    "loop",
    "max_iter"
  ],
  "outputs": [
    "files",
    "score",
    "summary",
    "issues",
    "versions",
    "written",
    "write_error",
    "engine"
  ]
}