{
  "name": "code-implement",
  "version": "0.3.0",
  "domain": "code",
  "description": "写码原子: 底层用本家自包含 code_agent_engine(CodeAgentEngine,含PONYTAIL+auto_reuse+loop+落Obsidian), 真写生产代码到磁盘。供 codeagent-minimal(唯一codeagent) p1 编码实现编排真写码。",
  "open_source": true,
  "agent_class": "CodeImplementAgent",
  "entry": "main.py",
  "provides": [
    "code.implement",
    "code.write"
  ],
  "depends_on": [],
  "inputs": [
    "task",
    "language",
    "path",
    "output_dir",
    "domain",
    "loop",
    "max_iter",
    "write_root",
    "verify",
    "skill_path"
  ],
  "outputs": [
    "files",
    "score",
    "summary",
    "issues",
    "versions",
    "written",
    "write_error",
    "engine"
  ],
  "permission": {
    "needs": [
      "read",
      "write",
      "exec",
      "net"
    ],
    "network": true
  },
  "resource": {
    "model_calls": 1,
    "timeout_sec": 600,
    "memory_mb": 1024
  }
}