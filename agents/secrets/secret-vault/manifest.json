{
  "name": "secret-vault",
  "version": "0.1.0",
  "domain": "secrets",
  "description": "密钥加密存储原子（P0，借鉴Codex keyring-store）: api_key等PBKDF2派生密钥+HMAC密钥流XOR静态加密落盘, 按需解密, 掩码展示。纯stdlib(静态混淆非强加密如实标注)。",
  "open_source": true,
  "agent_class": "SecretVaultAgent",
  "entry": "main.py",
  "provides": [
    "secrets.encrypt",
    "secrets.decrypt",
    "secrets.store",
    "secrets.load",
    "secrets.mask",
    "secrets.vault"
  ],
  "depends_on": [],
  "inputs": [
    "plaintext",
    "value",
    "passphrase",
    "name",
    "vault_dir",
    "bundle",
    "keep"
  ],
  "outputs": [
    "salt",
    "iv",
    "ciphertext",
    "tag",
    "decrypted",
    "stored",
    "name",
    "masked",
    "names"
  ],
  "path": "agents/secrets/secret-vault",
  "permission": {
    "needs": [
      "read",
      "write"
    ],
    "network": false
  },
  "resource": {
    "model_calls": 0,
    "timeout_sec": 120,
    "memory_mb": 512
  }
}
