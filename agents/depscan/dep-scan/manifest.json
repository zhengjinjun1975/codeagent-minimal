{
  "name": "dep-scan",
  "version": "0.2.0",
  "domain": "depscan",
  "description": "依赖漏洞SCA+污点+跨仓库断链原子：复用 dep_scan.scan_dependencies/taint_analyze/scan_all + chain_break.multi_repo_break_check，纯 stdlib 数据不出厂。SCA 依赖漏洞 + Semgrep 级 source→sink 污点分析 + 多仓库联动断链。",
  "open_source": true,
  "agent_class": "DepScanAgent",
  "entry": "main.py",
  "provides": [
    "depscan.scan",
    "depscan.sca",
    "depscan.taint",
    "depscan.osv",
    "depscan.chainbreak"
  ],
  "depends_on": [],
  "inputs": ["target", "osv_query", "allow_remote", "repos"],
  "outputs": ["deps", "vulns", "sca", "taint", "findings", "total_findings", "summary", "broken", "checks", "by_tier"],
  "path": "agents/depscan/dep-scan"
}
