    },
    "code-skill": {
      "name": "code-skill",
      "version": "0.1.0",
      "domain": "skill",
      "description": "SKILL.md 技能标准原子(新原子): 兼容 .opencode/.claude/.agents/skills 搜索路径, skill.load 按需加载省上下文, skill.export 把自进化沉淀技能转 SKILL.md 标准可交换资产。",
      "open_source": true,
