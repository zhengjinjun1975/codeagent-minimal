{
  "schema": "codeagent-registry-v1",
  "agents_dir": "agents",
  "agents": {
    "code-review": {
      "name": "code-review",
      "version": "0.1.0",
      "domain": "codereview",
      "description": "代码审查原子(多模): 复用 review.py._static_analyze/review_file/_dep_enrich, 静态审查+依赖图感知+复用建议。code/design/layout/content 四模。",
      "open_source": true,
      "agent_class": "CodeReviewAgent",
      "entry": "main.py",
      "provides": [
        "codereview.review",
        "codereview.design",
        "codereview.layout",
        "codereview.content"
      ],
      "depends_on": [
        "impact.analyze"
      ],
      "inputs": [
        "path",
        "code",
        "mode",
        "use_llm",
        "reuse_atoms",
        "max_complexity"
      ],
      "outputs": [
        "score",
        "issues",
        "static_issues",
        "model",
        "reuse_suggestions"
      ],
      "path": "agents\\codereview\\code-review"
    },
    "code-deliver": {
      "name": "code-deliver",
      "version": "0.1.0",
      "domain": "deliver",
      "description": "交付/报告原子: 汇总组装链各原子输出为验收报告(数据不出厂)。deliver.report 聚合 think/gen/review/test/evolve 结果, deliver.package 收集产物清单。",
      "open_source": true,
      "agent_class": "CodeDeliverAgent",
      "entry": "main.py",
      "provides": [
        "deliver.report",
        "deliver.package"
      ],
      "depends_on": [],
      "inputs": [
        "chain",
        "outputs",
        "evidence"
      ],
      "outputs": [
        "report",
        "artifacts",
        "verdict"
      ],
      "path": "agents\\deliver\\code-deliver"
    },
    "code-dispatch": {
      "name": "code-dispatch",
      "version": "0.1.0",
      "domain": "dispatch",
      "description": "派单原子: 复用 dispatch_template 派单5段 + estimate_budget 自适应预算 + back_to_back 背靠背验证 + check_workspace_conflicts 并行冲突防护。纯启发式/规则。",
      "open_source": true,
      "agent_class": "CodeDispatchAgent",
      "entry": "main.py",
      "provides": [
        "dispatch.template",
        "dispatch.budget",
        "dispatch.verify",
        "dispatch.conflict"
      ],
      "depends_on": [],
      "inputs": [
        "background",
        "goal",
        "constraint",
        "redline",
        "deliverable",
        "task",
        "files_needed",
        "language",
        "claims",
        "workdir",
        "rerun_cmd",
        "tasks",
        "workspace"
      ],
      "outputs": [
        "template",
        "budget",
        "items",
        "summary",
        "conflicts",
        "safe",
        "recommendation"
      ],
      "path": "agents\\dispatch\\code-dispatch"
    },
    "code-evolve": {
      "name": "code-evolve",
      "version": "0.1.0",
      "domain": "evolve",
      "description": "自进化原子: 复用 self_evolve.refine(观察→归因→精炼→校验四步闭环)/self_prompt/tdd_loop/_sediment_skill。evolve.refine 四步闭环+技能沉淀, evolve.tdd 红绿闭环。",
      "open_source": true,
      "agent_class": "CodeEvolveAgent",
      "entry": "main.py",
      "provides": [
        "evolve.refine",
        "evolve.skill",
        "evolve.self_prompt",
        "evolve.tdd"
      ],
      "depends_on": [
        "memory.recall"
      ],
      "inputs": [
        "task",
        "outcome",
        "snapshot",
        "memdir",
        "auto_sediment",
        "top_k"
      ],
      "outputs": [
        "observation",
        "attribution",
        "refinement",
        "kept",
        "verdict",
        "skills",
        "prompt",
        "tdd"
      ],
      "path": "agents\\evolve\\code-evolve"
    },
    "dep-impact": {
      "name": "dep-impact",
      "version": "0.1.0",
      "domain": "impact",
      "description": "依赖图影响分析原子：复用 dep_audit.build_graph/dep_report，零 LLM。分析改符号/模块波及谁、循环依赖、模块耦合。",
      "open_source": true,
      "agent_class": "DepImpactAgent",
      "entry": "main.py",
      "provides": [
        "impact.analyze",
        "impact.circular",
        "impact.coupling"
      ],
      "depends_on": [],
      "inputs": [
        "path",
        "symbol",
        "impact",
        "transitive"
      ],
      "outputs": [
        "files",
        "entities",
        "edges",
        "coupling",
        "circular_imports",
        "impact"
      ],
      "path": "agents\\impact\\dep-impact"
    },
    "llm-router": {
      "name": "llm-router",
      "version": "0.2.0",
      "domain": "llm",
      "description": "多模型 provider 注册表原子: 本地 ornith/Ollama + 云端 DeepSeek/GLM 等热扩展(改config即加模型)。llm.generate 云端按provider路由, llm.review 本地。llm.list_models/registry 模型目录。local-only 默认 True 数据不出厂。",
      "open_source": true,
      "agent_class": "LlmRouterAgent",
      "entry": "main.py",
      "provides": [
        "llm.generate",
        "llm.review",
        "llm.list_models",
        "llm.registry"
      ],
      "depends_on": [],
      "inputs": [
        "messages",
        "temp",
        "max_tokens",
        "local_only",
        "config_path",
        "provider",
        "model",
        "api_key"
      ],
      "outputs": [
        "content",
        "model",
        "provider",
        "type",
        "models",
        "registry"
      ],
      "path": "agents\\llm\\llm-router"
    },
    "mcp-client": {
      "name": "mcp-client",
      "version": "0.1.0",
      "domain": "mcp",
      "description": "MCP 客户端原子(新原子): 连外部 MCP server(local stdio + remote http), tools/list + tools/call 接入生态工具。默认 local_only 白名单, 远程需显式 allow_remote。零依赖纯标准库。",
      "open_source": true,
      "agent_class": "McpClientAgent",
      "entry": "main.py",
      "provides": [
        "mcp.list",
        "mcp.connect",
        "mcp.tools",
        "mcp.call"
      ],
      "depends_on": [],
      "inputs": [
        "server",
        "endpoint",
        "command",
        "tools",
        "timeout",
        "local_only",
        "allow_remote",
        "allow_tools"
      ],
      "outputs": [
        "servers",
        "tools",
        "result",
        "server"
      ],
      "path": "agents\\mcp\\mcp-client"
    },
    "code-memory": {
      "name": "code-memory",
      "version": "0.1.0",
      "domain": "memory",
      "description": "记忆/经验原子: 复用 self_evolve.remember/_load/_save + OptMem 思路。memory.save 经验沉淀, memory.recall 跨会话召回, memory.sediment 技能沉淀。落 experience/*.json。",
      "open_source": true,
      "agent_class": "CodeMemoryAgent",
      "entry": "main.py",
      "provides": [
        "memory.save",
        "memory.recall",
        "memory.sediment"
      ],
      "depends_on": [],
      "inputs": [
        "findings",
        "task",
        "memdir",
        "top_k"
      ],
      "outputs": [
        "added",
        "lessons",
        "prompt",
        "skills"
      ],
      "path": "agents\\memory\\code-memory"
    },
    "code-plan": {
      "name": "code-plan",
      "version": "0.1.0",
      "domain": "plan",
      "description": "方案设计原子: 复用 dispatch_template 派单5段模板任务拆解。plan.think 输出5段方案+文件清单, plan.gen 按方案产出代码骨架/透传代码。",
      "open_source": true,
      "agent_class": "CodePlanAgent",
      "entry": "main.py",
      "provides": [
        "plan.think",
        "plan.gen"
      ],
      "depends_on": [
        "taskstate.track"
      ],
      "inputs": [
        "task",
        "language",
        "domain",
        "files_needed",
        "spec"
      ],
      "outputs": [
        "plan",
        "assumptions",
        "files_needed",
        "constraint_chain",
        "questions",
        "files",
        "score"
      ],
      "path": "agents\\plan\\code-plan"
    },
    "code-project": {
      "name": "code-project",
      "version": "0.1.0",
      "domain": "project",
      "description": "项目加载/分析原子: 复用 load_project/scan_issues/analyze_project 思路, 产出项目快照+问题清单。project.load 快照, project.scan 扫描问题, project.analyze 分析。",
      "open_source": true,
      "agent_class": "CodeProjectAgent",
      "entry": "main.py",
      "provides": [
