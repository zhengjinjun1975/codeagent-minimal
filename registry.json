      "path": "agents\\skill\\code-skill"
    },
    "task-state": {
      "name": "task-state",
      "version": "0.1.0",
      "domain": "taskstate",
      "description": "任务状态原子: 复用 E:/optmem/taskstate/task_state.py 外置状态(做到哪/下一步/证据/决策点), 跨会话续跑不丢进度。taskstate.track 跟踪状态。",
      "open_source": true,
